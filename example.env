# NOTE: this bot also relays emoji reactions, so beyond the mood-bot scopes
# your Slack app needs the "reactions:read" bot scope and a subscription to
# the reaction_added event (in addition to message.im).
#
# NOTE: the setup questionnaire is triggered by a real /start slash command,
# not a plain-text message (Slack intercepts anything starting with "/" as a
# command attempt). In your Slack app config: Features → Slash Commands →
# Create New Command → Command: /start. Then add the "commands" bot scope
# under OAuth & Permissions, and reinstall the app to your workspace.
#
# NOTE: to forward photos/videos/files (not just describe them as text), the
# bot also needs the "files:read" bot scope, and re-uploads them with
# files_upload_v2, which needs "files:write". Add both, then reinstall.

# ── Slack Tokens ────────────────────────────────────────────────────────────
# Bot User OAuth Token  (OAuth & Permissions → Bot User OAuth Token)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-Level Token  (Basic Information → App-Level Tokens, scope: connections:write)
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# ── Users ────────────────────────────────────────────────────────────────────
# Your Slack user ID — the bot forwards everything the teammate below sends
# (messages AND emoji reactions) straight to you.
# Find it: click your name in Slack → View full profile → More → Copy member ID
ADMIN_USER_ID=U000000000

# The teammate's Slack user ID — this is who gets DMed the "bot details"
# setup questionnaire (e.g. Nouf). Every reply and reaction they give is
# relayed to ADMIN_USER_ID above.
TEAM_MEMBER_USER_ID=U000000000

# ── Group / ordering channel ────────────────────────────────────────────────
# Channel ID where the daily matcha recommendation gets posted so people can
# order. Leave blank until you've decided — the bot will ask for it in the
# setup DM and remind you to fill this in if it's missing.
# Find it: open the channel in Slack → View channel details → copy Channel ID
GROUP_CHANNEL_ID=

# ── Schedule ─────────────────────────────────────────────────────────────────
# Time to send the daily matcha recommendation (24-hour format, server local time)
SEND_TIME=09:00
